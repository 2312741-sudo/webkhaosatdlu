{
  "name": "webkhaosatdlu",
  "version": "1.0.0",
  "description": "Website Khảo sát Mức độ Hài lòng của Sinh viên - Khoa CNTT Trường Đại học Đà Lạt (DLU)",
  "scripts": {
    "dev": "concurrently --kill-others -n \"SERVER,CLIENT\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm run server\" \"npm run client\"",
    "server": "npm --prefix server run start",
    "client": "npm --prefix client run dev",
    "seed": "npm --prefix server run seed",
    "test": "npm --prefix server run test",
    "build": "npm --prefix client run build"
  },
  "keywords": [
    "dlu",
    "survey",
    "react",
    "nodejs",
    "express",
    "chartjs",
    "exceljs"
  ],
  "author": "Khoa CNTT - Đại học Đà Lạt",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
