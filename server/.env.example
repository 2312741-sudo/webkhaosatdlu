PORT=5001
# Chuỗi ngẫu nhiên tối thiểu 32 ký tự, BẮT BUỘC ở production. Tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
DB_PATH=./data/dlu_survey.db
# Các domain Frontend được phép gọi API (phân tách bằng dấu phẩy)
CLIENT_URL=http://localhost:5173
NODE_ENV=development
# OAuth Client ID từ Google Cloud Console (trùng với VITE_GOOGLE_CLIENT_ID phía client)
GOOGLE_CLIENT_ID=
# Đặt 1 khi chạy sau reverse proxy (Nginx / Render) để lấy đúng IP người dùng
TRUST_PROXY=
# CHỈ dùng khi demo trên máy cục bộ: cho phép đăng nhập Google bằng cách nhập email (chỉ tài khoản sinh viên).
# Không có tác dụng khi NODE_ENV=production.
ALLOW_DEV_GOOGLE_LOGIN=false
